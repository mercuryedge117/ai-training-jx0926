# Copy this file to .env for local demos.
# Leave values blank for offline/mock mode, or fill them in locally for live demos.

# Slack live mode, used by session-01-setup/hello_bot.py when both tokens are present.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# LLM live mode. Provider priority: OpenAI > Anthropic > DeepSeek.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional live-demo tuning.
DEMO_MODEL=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1
